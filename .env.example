# URL chính thức của website, không có dấu / ở cuối
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Trang đăng nhập/quản trị trong cùng website demo
NEXT_PUBLIC_APP_URL=https://www.example.com/admin

# Supabase Free: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Webhook nhận dữ liệu từ biểu mẫu liên hệ
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
