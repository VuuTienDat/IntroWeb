# URL chính thức của website, không có dấu / ở cuối
NEXT_PUBLIC_SITE_URL=https://www.example.com

# URL web app mặc định dành cho khách hàng (không phải trang /admin)
NEXT_PUBLIC_APP_URL=https://app.example.com

# Supabase Free: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Webhook nhận dữ liệu từ biểu mẫu liên hệ
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
