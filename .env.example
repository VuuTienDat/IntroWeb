# URL chính thức của website, không có dấu / ở cuối
NEXT_PUBLIC_SITE_URL=https://www.example.com

# URL của web app có đăng nhập Google
NEXT_PUBLIC_APP_URL=https://app.example.com

# WordPress headless: có thể điền URL site hoặc URL REST API đầy đủ
# Ví dụ: https://cms.example.com/wp-json/wp/v2
WORDPRESS_API_URL=

# Webhook nhận dữ liệu từ biểu mẫu liên hệ
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
